# ============================================
# MediHelp Server — Environment Variables
# Copy this file to `.env` and fill real values.
# NEVER commit `.env` to GitHub!
# ============================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Get this from MongoDB Atlas (free M0 cluster)
# Format: mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/medihub
MONGODB_URI=mongodb+srv://medihub-admin:CFb95Rl9CS6ZmReV@medihub-cluster.jivksvh.mongodb.net/

# --- Frontend URL (for CORS whitelist) ---
CLIENT_URL=http://localhost:5173

# --- Clerk Auth (add in Phase 1, leave blank for now) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# --- Razorpay (add in Phase 5, leave blank for now) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=